<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Hardened-runtime exceptions required by Electron + V8 JIT.
      Same set EasyClaw uses; well-trodden territory.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!--
      The wizard needs outbound network for the /health probe and to
      open install URLs in the system browser.
    -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
