{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Factotem Doctor",
  "version": "0.1.0",
  "identifier": "co.factotem.doctor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1422",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray-template.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true,
      "title": null,
      "tooltip": "Factotem Doctor"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "Cold-start helper for Factotem / NanoClaw",
    "longDescription": "Persistent menu-bar status icon for the Factotem (NanoClaw) deployment. Surfaces Docker / OneCLI / NanoClaw health, detects multiple running instances, and provides a typed-confirm Repair Stack action for cold-start recovery.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "entitlements": null,
      "dmg": {
        "background": null,
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
