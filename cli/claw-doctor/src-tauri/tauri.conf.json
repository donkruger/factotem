{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Factotem Doctor",
  "version": "0.1.8",
  "identifier": "co.factotem.doctor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1422",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDMjIzNjhBMjhCNkYxQTYKUldTbThiWW9pallpN0dUeUZzUEdkY01HSzQwOHIwVXBuczkxMzJnREM5OWRXS2Y2NWR0QWVYWVcK",
      "endpoints": [
        "https://github.com/RichardBNel/Factotem/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray-template.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true,
      "title": null,
      "tooltip": "Factotem Doctor"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../../scripts/recovery/recovery.html": "recovery.html"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "Cold-start helper for Factotem / NanoClaw",
    "longDescription": "Persistent menu-bar status icon for the Factotem (NanoClaw) deployment. Surfaces Docker / OneCLI / NanoClaw health, detects multiple running instances, and provides a typed-confirm Repair Stack action for cold-start recovery.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": "D8G67T74V6",
      "signingIdentity": "Developer ID Application: Don Kruger (D8G67T74V6)",
      "entitlements": "entitlements.plist",
      "dmg": {
        "background": null,
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
