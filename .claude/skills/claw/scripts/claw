#!/usr/bin/env python3
"""
claw — NanoClaw CLI
Run a NanoClaw agent container from the command line.

Usage:
  claw "What is 2+2?"
  claw -g <channel_name> "Review this code"
  claw -g "<channel name with spaces>" "What's the latest issue?"
  claw -j "<chatJid>" "Hello"
  claw -g <channel_name> -s <session-id> "Continue"
  claw --list-groups
  echo "prompt text" | claw --pipe -g <channel_name>
  cat prompt.txt | claw --pipe
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import threading
import time
from pathlib import Path

# ── Globals ─────────────────────────────────────────────────────────────────

VERBOSE = False

def dbg(*args):
    if VERBOSE:
        print("»", *args, file=sys.stderr)

# ── Config ──────────────────────────────────────────────────────────────────

def _find_nanoclaw_dir() -> Path:
    """Locate the NanoClaw installation directory.

    Resolution order:
    1. NANOCLAW_DIR env var
    2. The directory containing this script (if it looks like a NanoClaw install)
    3. ~/src/nanoclaw (legacy default)
    """
    if env := os.environ.get("NANOCLAW_DIR"):
        return Path(env).expanduser()
    # If this script lives inside the NanoClaw tree (e.g. scripts/claw), walk up
    here = Path(__file__).resolve()
    for parent in [here.parent, here.parent.parent]:
        if (parent / "store" / "messages.db").exists() or (parent / ".env").exists():
            return parent
    return Path.home() / "src" / "nanoclaw"

NANOCLAW_DIR = _find_nanoclaw_dir()
DB_PATH      = NANOCLAW_DIR / "store" / "messages.db"
ENV_FILE     = NANOCLAW_DIR / ".env"
IMAGE        = "nanoclaw-agent:latest"

SECRET_KEYS = [
    "CLAUDE_CODE_OAUTH_TOKEN",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_BASE_URL",
    "ANTHROPIC_AUTH_TOKEN",
    "OLLAMA_HOST",
]

# ── Helpers ──────────────────────────────────────────────────────────────────

def detect_runtime(preference: str | None) -> str:
    if preference:
        dbg(f"runtime: forced to {preference}")
        return preference
    for rt in ("container", "docker"):
        result = subprocess.run(["which", rt], capture_output=True)
        if result.returncode == 0:
            dbg(f"runtime: auto-detected {rt} at {result.stdout.decode().strip()}")
            return rt
    sys.exit("error: neither 'container' nor 'docker' found. Install one or pass --runtime.")


def read_secrets(env_file: Path) -> dict:
    secrets = {}
    if not env_file.exists():
        return secrets
    for line in env_file.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" in line:
            key, _, val = line.partition("=")
            key = key.strip()
            if key in SECRET_KEYS:
                secrets[key] = val.strip()
    return secrets


def get_groups(db: Path) -> list[dict]:
    conn = sqlite3.connect(db)
    rows = conn.execute(
        "SELECT jid, name, folder, is_main FROM registered_groups ORDER BY name"
    ).fetchall()
    conn.close()
    return [{"jid": r[0], "name": r[1], "folder": r[2], "is_main": bool(r[3])} for r in rows]


def find_group(groups: list[dict], query: str) -> dict | None:
    q = query.lower()
    # Exact name match
    for g in groups:
        if g["name"].lower() == q or g["folder"].lower() == q:
            return g
    # Partial match
    matches = [g for g in groups if q in g["name"].lower() or q in g["folder"].lower()]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        names = ", ".join(f'"{g["name"]}"' for g in matches)
        sys.exit(f"error: ambiguous group '{query}'. Matches: {names}")
    return None


def build_mounts(folder: str, is_main: bool) -> list[tuple[str, str, bool]]:
    """Return list of (host_path, container_path, readonly) tuples."""
    groups_dir  = NANOCLAW_DIR / "groups"
    data_dir    = NANOCLAW_DIR / "data"
    sessions_dir = data_dir / "sessions" / folder
    ipc_dir     = data_dir / "ipc" / folder

    # Ensure required dirs exist
    group_dir = groups_dir / folder
    group_dir.mkdir(parents=True, exist_ok=True)
    (sessions_dir / ".claude").mkdir(parents=True, exist_ok=True)
    for sub in ("messages", "tasks", "input"):
        (ipc_dir / sub).mkdir(parents=True, exist_ok=True)

    agent_runner_src = sessions_dir / "agent-runner-src"
    project_agent_runner = NANOCLAW_DIR / "container" / "agent-runner" / "src"
    if not agent_runner_src.exists() and project_agent_runner.exists():
        import shutil
        shutil.copytree(project_agent_runner, agent_runner_src)

    mounts: list[tuple[str, str, bool]] = []
    if is_main:
        mounts.append((str(NANOCLAW_DIR), "/workspace/project", True))
    mounts.append((str(group_dir),           "/workspace/group",    False))
    mounts.append((str(sessions_dir / ".claude"), "/home/node/.claude", False))
    mounts.append((str(ipc_dir),             "/workspace/ipc",      False))
    if agent_runner_src.exists():
        mounts.append((str(agent_runner_src), "/app/src",           False))
    return mounts


def run_container(runtime: str, image: str, payload: dict,
                  folder: str | None = None, is_main: bool = False,
                  timeout: int = 300) -> None:
    cmd = [runtime, "run", "-i", "--rm"]
    if folder:
        for host, container, readonly in build_mounts(folder, is_main):
            if readonly:
                cmd += ["--mount", f"type=bind,source={host},target={container},readonly"]
            else:
                cmd += ["-v", f"{host}:{container}"]
    cmd.append(image)
    dbg(f"cmd: {' '.join(cmd)}")

    # Show payload sans secrets
    if VERBOSE:
        safe = {k: v for k, v in payload.items() if k != "secrets"}
        safe["secrets"] = {k: "***" for k in payload.get("secrets", {})}
        dbg(f"payload: {json.dumps(safe, indent=2)}")

    proc = subprocess.Popen(
        cmd,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    dbg(f"container pid: {proc.pid}")

    # Write JSON payload and close stdin
    proc.stdin.write(json.dumps(payload).encode())
    proc.stdin.close()
    dbg("stdin closed, waiting for response...")

    stdout_lines: list[str] = []
    stderr_lines: list[str] = []
    done = threading.Event()

    def stream_stderr():
        for raw in proc.stderr:
            line = raw.decode(errors="replace").rstrip()
            if line.startswith("npm notice"):
                continue
            stderr_lines.append(line)
            print(line, file=sys.stderr)

    def stream_stdout():
        for raw in proc.stdout:
            line = raw.decode(errors="replace").rstrip()
            stdout_lines.append(line)
            dbg(f"stdout: {line}")
            # Kill the container as soon as we see the closing sentinel —
            # the Node.js event loop often keeps the process alive indefinitely.
            if line.strip() == "---NANOCLAW_OUTPUT_END---":
                dbg("output sentinel found, terminating container")
                done.set()
                try:
                    proc.terminate()
                    try:
                        proc.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        dbg("graceful stop timed out, force killing container")
                        proc.kill()
                except ProcessLookupError:
                    pass
                return

    t_err = threading.Thread(target=stream_stderr, daemon=True)
    t_out = threading.Thread(target=stream_stdout, daemon=True)
    t_err.start()
    t_out.start()

    # Wait for sentinel or timeout
    if not done.wait(timeout=timeout):
        # Also check if process exited naturally
        t_out.join(timeout=2)
        if not done.is_set():
            proc.kill()
            sys.exit(f"error: container timed out after {timeout}s (no output sentinel received)")

    t_err.join(timeout=5)
    t_out.join(timeout=5)
    proc.wait()
    dbg(f"container done (rc={proc.returncode}), {len(stdout_lines)} stdout lines")
    stdout = "\n".join(stdout_lines)

    # Parse output block
    match = re.search(
        r"---NANOCLAW_OUTPUT_START---\n(.*?)\n---NANOCLAW_OUTPUT_END---",
        stdout,
        re.DOTALL,
    )
    success = False

    if match:
        try:
            data = json.loads(match.group(1))
            status = data.get("status", "unknown")
            if status == "success":
                print(data.get("result", ""))
                session_id = data.get("newSessionId") or data.get("sessionId")
                if session_id:
                    print(f"\n[session: {session_id}]", file=sys.stderr)
                success = True
            else:
                print(f"[{status}] {data.get('result', '')}", file=sys.stderr)
                sys.exit(1)
        except json.JSONDecodeError:
            print(match.group(1))
    else:
        # No structured output — print raw stdout
        print(stdout)

    if success:
        return

    if proc.returncode not in (0, None):
        sys.exit(proc.returncode)


# ── Operator verbs: doctor / status / logs ───────────────────────────────────
#
# A small, discoverable verb surface (inspired by `hermes doctor` / `hermes
# status` in NousResearch/hermes-agent) layered onto the CLI binary operators
# already have on PATH. Each verb REUSES an existing NanoClaw primitive rather
# than reimplementing any probe:
#
#   claw doctor → runs the wizard's own health probe (setup/verify.ts) and
#                 pretty-prints the machine-readable VERIFY block that
#                 setup/status.ts::emitStatus produces. The block is consumed,
#                 never modified — the wizard/LLM contract is untouched. Works
#                 even when the orchestrator is down (the probe reads
#                 launchd/systemd/disk directly).
#   claw status → quick liveness read from the orchestrator's /health endpoint
#                 (src/http/server.ts; JSON shape in src/http/health.ts).
#   claw logs   → tail logs/nanoclaw.log — the sanctioned replacement for the
#                 raw `tail -f` the setup handoff used to surface.
#
# Dispatch (in main) only triggers when the first bare token is exactly a known
# verb; any other invocation falls through to the prompt-send path unchanged.

VERBS = ("doctor", "status", "logs", "reset-session", "help")


class _Palette:
    """ANSI colours matching the wizard's vocabulary (cli/claw-setup/src/ui.ts):
    green ✓, yellow ⚠, red ✗, cyan headers, dim secondary. No-ops when colour
    is disabled (--no-color, NO_COLOR, or non-TTY stdout)."""

    def __init__(self, enabled: bool):
        self.enabled = enabled

    def _wrap(self, code: str, s: str) -> str:
        return f"\033[{code}m{s}\033[0m" if self.enabled else s

    def green(self, s):  return self._wrap("32", s)
    def yellow(self, s): return self._wrap("33", s)
    def red(self, s):    return self._wrap("31", s)
    def cyan(self, s):   return self._wrap("36", s)
    def bold(self, s):   return self._wrap("1", s)
    def dim(self, s):    return self._wrap("2", s)


def _color_enabled(rest_args: list) -> bool:
    # Mirrors cli/claw-setup/src/ui.ts::createUI (honours --no-color + NO_COLOR);
    # additionally suppresses ANSI when stdout isn't a TTY (piped to a file).
    if "--no-color" in rest_args:
        return False
    if os.environ.get("NO_COLOR"):
        return False
    return sys.stdout.isatty()


def _row(pal: "_Palette", level: str, label: str, value: str, hint: str = "") -> None:
    glyph = {"ok": pal.green("✓"), "warn": pal.yellow("⚠")}.get(level, pal.red("✗"))
    print(f"  {glyph} {label}: {value}")
    if hint:
        print("      " + pal.dim("→ " + hint))


def _human_duration(seconds: int) -> str:
    if seconds < 60:
        return f"{seconds}s"
    mins, secs = divmod(seconds, 60)
    if mins < 60:
        return f"{mins}m {secs}s"
    hours, mins = divmod(mins, 60)
    if hours < 24:
        return f"{hours}h {mins}m"
    days, hours = divmod(hours, 24)
    return f"{days}d {hours}h"


def _run_verify_probe() -> tuple:
    """Run the existing setup/verify.ts step; return (combined_output, returncode).

    `claw` runs in the operator's interactive shell, so `npx tsx` resolves the
    project-local tsx without the launchd minimal-PATH ENOENT trap that affects
    the launchd-spawned orchestrator. Sentinel return codes: 127 = couldn't
    launch, 124 = timed out — the caller renders a friendly line, not a traceback.
    """
    cmd = ["npx", "tsx", "setup/index.ts", "--step", "verify"]
    try:
        proc = subprocess.run(
            cmd, cwd=str(NANOCLAW_DIR),
            capture_output=True, text=True, timeout=120,
        )
    except FileNotFoundError:
        return ("", 127)
    except subprocess.TimeoutExpired:
        return ("", 124)
    return (f"{proc.stdout}\n{proc.stderr}", proc.returncode)


def _parse_status_block(text: str, step: str) -> dict:
    """Extract a `=== NANOCLAW SETUP: <step> === … === END ===` block into a
    {KEY: value} dict. Splits each row on the FIRST colon so JSON values (which
    contain colons) survive intact. Returns {} when no block is present."""
    m = re.search(
        r"=== NANOCLAW SETUP: " + re.escape(step) + r" ===\n(.*?)\n=== END ===",
        text, re.DOTALL,
    )
    if not m:
        return {}
    fields = {}
    for line in m.group(1).splitlines():
        if ":" in line:
            key, _, val = line.partition(":")
            fields[key.strip()] = val.strip()
    return fields


def cmd_doctor(rest_args: list) -> int:
    pal = _Palette(_color_enabled(rest_args))
    print(pal.bold(pal.cyan("NanoClaw health check")))
    print(pal.dim(f"  probe: setup/verify.ts   dir: {NANOCLAW_DIR}"))
    print()

    output, rc = _run_verify_probe()
    if rc == 127:
        _row(pal, "bad", "Health probe", "couldn't start",
             "Node/npx not found on PATH. Run from a normal Terminal, or re-run setup.")
        return 1
    if rc == 124:
        _row(pal, "bad", "Health probe", "timed out (120s)",
             "Host may be busy. Check `claw logs` to see what NanoClaw is doing.")
        return 1

    f = _parse_status_block(output, "VERIFY")
    if not f:
        _row(pal, "bad", "Health probe", "no result",
             "verify produced no status block. Run "
             "`npx tsx setup/index.ts --step verify` in the repo to see the raw error.")
        return 1

    service = f.get("SERVICE", "unknown")
    if service == "running":
        _row(pal, "ok", "Service", "running")
    elif service == "stopped":
        _row(pal, "bad", "Service", "installed but not running",
             "Restart: launchctl kickstart -k gui/$(id -u)/com.nanoclaw   "
             "(Linux: systemctl --user restart nanoclaw)")
    elif service == "not_found":
        _row(pal, "bad", "Service", "not installed",
             "Run the setup wizard from the repo root: npm run claw-setup")
    else:
        _row(pal, "warn", "Service", service)

    runtime = f.get("CONTAINER_RUNTIME", "none")
    if runtime in ("docker", "apple-container"):
        _row(pal, "ok", "Container runtime", runtime)
    else:
        _row(pal, "bad", "Container runtime", "none found",
             "Start Docker Desktop, or install Apple Container (macOS 15+).")

    creds = f.get("CREDENTIALS", "missing")
    if creds == "configured":
        _row(pal, "ok", "Credentials", "configured")
    else:
        _row(pal, "bad", "Credentials", "none found",
             "Re-run setup, or check .env / OneCLI (onecli secrets list).")

    channels = {}
    raw_auth = f.get("CHANNEL_AUTH", "")
    if raw_auth:
        try:
            channels = json.loads(raw_auth)
        except json.JSONDecodeError:
            channels = {}
    if channels:
        for name, state in channels.items():
            _row(pal, "ok", f"Channel · {name}", str(state))
    elif f.get("CONFIGURED_CHANNELS"):
        _row(pal, "ok", "Channels", f["CONFIGURED_CHANNELS"])
    else:
        _row(pal, "warn", "Channels", "none configured",
             "Add one: /add-whatsapp, /add-telegram, /add-slack, or /add-discord.")

    groups = f.get("REGISTERED_GROUPS", "0")
    db_error = f.get("DB_ERROR")
    if groups == "unknown" or db_error:
        # A failed DB read (commonly a better-sqlite3 ABI mismatch) is NOT zero
        # groups — verify.ts emits REGISTERED_GROUPS: unknown + DB_ERROR for it.
        # Render a warning with the actionable hint, never a green ✓ on a bogus
        # count. Doesn't gate overall health (STATUS already accounts for it).
        hint = f.get("DB_ERROR_HINT") or (
            "Couldn't read store/messages.db. Run `claw doctor` from the same "
            "Node as the service, or `npm rebuild better-sqlite3`.")
        _row(pal, "warn", "Registered groups", "couldn't read database", hint)
    elif groups not in ("0", ""):
        _row(pal, "ok", "Registered groups", groups)
    else:
        _row(pal, "warn", "Registered groups", "none yet",
             "Register your main chat during setup, or DM the agent to onboard.")

    mounts = f.get("MOUNT_ALLOWLIST", "missing")
    if mounts == "configured":
        _row(pal, "ok", "Mount allowlist", "configured")
    else:
        _row(pal, "warn", "Mount allowlist", "not set",
             "Optional — folders the agent may read/write. Configured during setup.")

    # ── Incident-grounded checks (ben-log 2026-06). A `critical_fail` here makes
    #    the verdict ✗ even when verify.ts STATUS is success (the wizard gate is
    #    intentionally narrower than the operator doctor).
    critical_fail = False

    # Live auth — the disguised-429 / Bearer-vs-x-api-key saga went undiagnosed
    # for hours; surface the real probe result.
    auth_mode = f.get("AUTH_MODE", "unknown")
    auth_live = f.get("AUTH_LIVE", "unknown")
    if auth_live == "live":
        _row(pal, "ok", "Auth (live)", f"{auth_mode} · Anthropic accepted the credential")
    elif auth_live == "rejected":
        critical_fail = True
        _row(pal, "bad", "Auth (live)", f"{auth_mode} · Anthropic REJECTED the credential",
             f.get("AUTH_HINT") or "Re-mint/rotate the credential, then re-run `claw doctor`.")
    elif auth_mode != "unknown":
        _row(pal, "warn", "Auth (live)", f"{auth_mode} · couldn't verify live",
             "OneCLI/proxy may be down, or this is api-key mode. Check `claw status`.")

    # OneCLI credential gateway — agents can't authenticate without it.
    onecli = f.get("ONECLI", "unknown")
    if onecli == "reachable":
        _row(pal, "ok", "OneCLI gateway", ":10254 reachable")
    elif onecli == "down":
        critical_fail = True
        _row(pal, "bad", "OneCLI gateway", "unreachable",
             "Credential gateway down — agents can't authenticate. "
             "Start it: cd ~/.onecli && docker compose up -d")

    # WhatsApp — the LIVE connected state (replaces the stale dir heuristic that
    # reported 'authenticated' while the session was logged out, 401).
    wa = f.get("WHATSAPP_CONNECTED", "unknown")
    if wa == "true":
        _row(pal, "ok", "WhatsApp", "connected")
    elif wa == "false":
        critical_fail = True
        _row(pal, "bad", "WhatsApp", "logged out / not connected",
             "Re-pair: open the setup wizard, or run the WhatsApp auth step. "
             "A logged-out session also crash-loops the orchestrator.")

    # Model-ID validity — the claude-opus-4.6 (dot vs dash) typo silently 404'd
    # every turn for 30 minutes.
    model_check = f.get("MODEL_CHECK", "ok")
    if model_check == "bad":
        critical_fail = True
        _row(pal, "bad", "Model", "invalid model id",
             f.get("MODEL_HINT") or "An agent's provider_model isn't a valid Anthropic id.")
    elif model_check == "unknown":
        _row(pal, "warn", "Model", "couldn't read agents",
             f.get("MODEL_HINT") or "Couldn't read the agents table to validate models.")
    else:
        _row(pal, "ok", "Model", "valid")

    # Large pinned session → slow/hung resume.
    big = f.get("BIG_SESSION")
    if big:
        grp = big.split(":")[0]
        _row(pal, "warn", "Session size", big.replace(":", " · "),
             f"Large transcript can hang resume. Archive it: claw reset-session {grp}")

    print()
    if f.get("STATUS") == "success" and not critical_fail:
        print("  " + pal.green(pal.bold("✓ Everything looks healthy.")))
        return 0
    log = f.get("LOG", "logs/setup.log")
    print("  " + pal.red(pal.bold("✗ NanoClaw isn't fully healthy.")))
    print("  " + pal.dim(f"Fix the ✗ items above, then re-run `claw doctor`.  "
                         f"Live log: claw logs -f    setup log: {log}"))
    return 1


def cmd_status(rest_args: list) -> int:
    import urllib.error
    import urllib.request

    pal = _Palette(_color_enabled(rest_args))
    port = os.environ.get("NANOCLAW_HTTP_PORT", "7842")
    url = f"http://localhost:{port}/health"
    try:
        with urllib.request.urlopen(url, timeout=5) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
    except (urllib.error.URLError, OSError, ValueError):
        print(pal.yellow(f"⚠ NanoClaw isn't responding on :{port}/health"))
        print(pal.dim("  The orchestrator may be down. Run `claw doctor` for a full diagnosis."))
        return 1

    try:
        h = json.loads(raw)
    except json.JSONDecodeError:
        print(raw)
        return 0

    print(pal.bold(pal.cyan(f"NanoClaw status   :{port}/health")))
    nc = h.get("nanoclaw", {})
    _row(pal, "ok", "NanoClaw",
         f"running   v{nc.get('version', '?')}   "
         f"up {_human_duration(int(nc.get('uptime_seconds', 0) or 0))}")

    dk = h.get("docker", {})
    if dk.get("running"):
        _row(pal, "ok", "Docker",
             f"{dk.get('containers_active', 0)} / {dk.get('max_concurrent', '?')} agent containers active")
    else:
        _row(pal, "bad", "Docker", "engine not responding",
             "Start Docker Desktop (or Apple Container).")

    oc = h.get("onecli", {})
    if oc.get("reachable"):
        _row(pal, "ok", "OneCLI",
             f"reachable ({oc.get('latency_ms')}ms)   auth: {oc.get('auth_mode') or 'unknown'}")
    else:
        _row(pal, "bad", "OneCLI", "unreachable",
             "Credential gateway is down — agents can't authenticate. See `claw doctor`.")

    wa = h.get("whatsapp", {})
    pairings = wa.get("pairings") or []
    if wa.get("authenticated"):
        last = wa.get("last_message_at") or "no messages yet"
        suffix = f"   {len(pairings)} pairing(s)" if pairings else ""
        _row(pal, "ok", "WhatsApp", f"authenticated   last msg: {last}{suffix}")
    else:
        _row(pal, "warn", "WhatsApp", "not authenticated",
             "Pair a phone during setup, or re-pair with `npm run claw-setup -- --force`.")

    od = h.get("open_dm", {})
    if od.get("enabled"):
        budget = od.get("daily_budget_cents")
        cap = f" / {budget}¢ cap" if budget is not None else ""
        _row(pal, "ok", "Open-DM", f"on   ({od.get('today_spent_cents', 0)}¢ spent today{cap})")

    return 0


def _resolve_orchestrator_log() -> Path:
    """The live orchestrator log. Since the 2026-06-09 plist regeneration the
    service writes `.logs/nanoclaw.out.log`; the old `logs/nanoclaw.log` is
    stale and silently misleads (ben-log 2026-06-12). Prefer the new path, fall
    back to the legacy one for older installs."""
    new = NANOCLAW_DIR / ".logs" / "nanoclaw.out.log"
    legacy = NANOCLAW_DIR / "logs" / "nanoclaw.log"
    return new if new.exists() else legacy


def cmd_logs(rest_args: list) -> int:
    pal = _Palette(_color_enabled(rest_args))
    follow = "-f" in rest_args or "--follow" in rest_args
    if "--setup" in rest_args:
        log_path = NANOCLAW_DIR / "logs" / "setup.log"
    else:
        log_path = _resolve_orchestrator_log()

    if not log_path.exists():
        print(pal.yellow(f"⚠ No log yet at {log_path}"))
        print(pal.dim("  Has setup run? Try `claw doctor`."))
        return 1

    if follow:
        try:
            return subprocess.run(["tail", "-f", str(log_path)]).returncode
        except KeyboardInterrupt:
            return 0
        except FileNotFoundError:
            print(pal.yellow("⚠ `tail` not found; showing the tail once instead."))

    try:
        proc = subprocess.run(["tail", "-n", "40", str(log_path)],
                              capture_output=True, text=True)
        sys.stdout.write(proc.stdout)
        return proc.returncode
    except FileNotFoundError:
        print("\n".join(log_path.read_text(errors="replace").splitlines()[-40:]))
        return 0


def cmd_reset_session(rest_args: list) -> int:
    """Archive a group's Claude session transcript and clear its `sessions`
    row, so the next turn starts a fresh session. The operator fix for the
    stale/oversized-session resume hang (ben-log 2026-06-12): a large or
    poisoned transcript can wedge the agent before any API call.

    Reuses Python's stdlib sqlite3 (reads/writes the same messages.db the
    orchestrator uses — no better-sqlite3 ABI concern). The session map is
    held in memory by the running orchestrator, so a restart is required for
    the cleared pointer to take effect — we print that explicitly."""
    pal = _Palette(_color_enabled(rest_args))
    positional = [a for a in rest_args if not a.startswith("-")]
    if not positional:
        print(pal.yellow("Usage: claw reset-session <group-folder>"))
        print(pal.dim("  e.g. claw reset-session gga    (see folders via: claw --list-groups)"))
        return 1
    group = positional[0].strip().lower()

    if not DB_PATH.exists():
        print(pal.red(f"✗ No database at {DB_PATH}"))
        return 1

    # Look up the pinned session for this group.
    try:
        conn = sqlite3.connect(f"file:{DB_PATH}?mode=rw", uri=True)
        try:
            row = conn.execute(
                "SELECT session_id FROM sessions WHERE group_folder = ?", (group,)
            ).fetchone()
        finally:
            conn.close()
    except sqlite3.Error as e:
        print(pal.red(f"✗ Couldn't read sessions table: {e}"))
        return 1

    if row is None:
        print(pal.yellow(f"⚠ No pinned session for group '{group}'."))
        print(pal.dim("  Nothing to reset — the next turn already starts fresh. "
                      "Check the folder name with `claw --list-groups`."))
        return 1
    session_id = row[0]

    # Archive the transcript + project dir (best-effort; never block the reset).
    ts = time.strftime("%Y%m%d-%H%M%S")
    proj = NANOCLAW_DIR / "data" / "sessions" / group / ".claude" / "projects" / "-workspace-group"
    archived = NANOCLAW_DIR / "data" / "sessions" / group / ".claude" / f"_archived-{ts}"
    moved = []
    for src in (proj / f"{session_id}.jsonl", proj / session_id):
        if src.exists():
            try:
                archived.mkdir(parents=True, exist_ok=True)
                shutil.move(str(src), str(archived / src.name))
                moved.append(src.name)
            except OSError as e:
                print(pal.yellow(f"⚠ Couldn't archive {src.name}: {e}"))

    # Clear the pinned session so the next turn starts a new one.
    try:
        conn = sqlite3.connect(f"file:{DB_PATH}?mode=rw", uri=True)
        try:
            conn.execute("DELETE FROM sessions WHERE group_folder = ?", (group,))
            conn.commit()
        finally:
            conn.close()
    except sqlite3.Error as e:
        print(pal.red(f"✗ Couldn't clear the session pointer: {e}"))
        return 1

    print(pal.green(pal.bold(f"✓ Reset session for '{group}'.")))
    print(pal.dim(f"  cleared sessions row (was {session_id})"))
    if moved:
        print(pal.dim(f"  archived {', '.join(moved)} → .claude/_archived-{ts}/"))
    print()
    print("  " + pal.bold("Restart the orchestrator for this to take effect:"))
    print(pal.dim("    launchctl kickstart -k gui/$(id -u)/com.nanoclaw   "
                  "(Linux: systemctl --user restart nanoclaw)"))
    print(pal.dim("  The next message to the group then starts a fresh session."))
    return 0


def _print_verb_help() -> None:
    print(
        "claw — NanoClaw CLI\n\n"
        "Send a prompt to an agent:\n"
        "  claw \"What's on my calendar today?\"\n"
        "  claw -g family \"Remind everyone about dinner\"\n"
        "  claw --list-groups\n"
        "  (full prompt options: claw --help)\n\n"
        "Operator verbs (diagnostics — no prompt sent):\n"
        "  claw doctor                full health check (service, runtime, creds,\n"
        "                             live auth, OneCLI, WhatsApp, model, sessions)\n"
        "  claw status                quick liveness read from the orchestrator's /health\n"
        "  claw logs [-f]             recent orchestrator log lines (-f to follow)\n"
        "  claw logs --setup          show the setup log instead\n"
        "  claw reset-session <grp>   archive a stuck/large session + clear its pointer\n"
    )


# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    # Operator-verb dispatch (claw doctor / status / logs / help). Only fires
    # when the first bare token is exactly a known verb; every other invocation
    # — including a quoted prompt that merely starts with the word — falls
    # through to the prompt-send path below, unchanged.
    raw_argv = sys.argv[1:]
    if raw_argv and raw_argv[0] in VERBS:
        verb, rest = raw_argv[0], raw_argv[1:]
        if verb == "help":
            _print_verb_help()
            return
        if verb == "doctor":
            sys.exit(cmd_doctor(rest))
        if verb == "status":
            sys.exit(cmd_status(rest))
        if verb == "logs":
            sys.exit(cmd_logs(rest))
        if verb == "reset-session":
            sys.exit(cmd_reset_session(rest))

    parser = argparse.ArgumentParser(
        prog="claw",
        description="Run a NanoClaw agent from the command line.",
        epilog=(
            "operator verbs (diagnostics, no prompt sent):\n"
            "  claw doctor               full health check (reuses setup/verify.ts)\n"
            "  claw status               quick /health liveness read\n"
            "  claw logs [-f]            recent orchestrator log lines (-f follows)\n"
            "  claw reset-session <grp>  archive a stuck/large session + clear pointer\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("prompt", nargs="?", help="Prompt to send")
    parser.add_argument("-g", "--group", help="Group name or folder (fuzzy match)")
    parser.add_argument("-j", "--jid", help="Chat JID (exact)")
    parser.add_argument("-s", "--session", help="Session ID to resume")
    parser.add_argument("-p", "--pipe", action="store_true",
                        help="Read prompt from stdin (can be combined with a prompt arg as prefix)")
    parser.add_argument("--runtime", choices=["docker", "container"],
                        help="Container runtime (default: auto-detect)")
    parser.add_argument("--image", default=IMAGE, help=f"Container image (default: {IMAGE})")
    parser.add_argument("--list-groups", action="store_true", help="List registered groups and exit")
    parser.add_argument("--raw", action="store_true", help="Print raw JSON output")
    parser.add_argument("--timeout", type=int, default=300, metavar="SECS",
                        help="Max seconds to wait for a response (default: 300)")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="Show debug info: cmd, payload (secrets redacted), stdout lines, exit code")
    args = parser.parse_args()

    global VERBOSE
    VERBOSE = args.verbose

    groups = get_groups(DB_PATH) if DB_PATH.exists() else []

    if args.list_groups:
        print(f"{'NAME':<35} {'FOLDER':<30} {'JID'}")
        print("-" * 100)
        for g in groups:
            main_tag = " [main]" if g["is_main"] else ""
            print(f"{g['name']:<35} {g['folder']:<30} {g['jid']}{main_tag}")
        return

    # Resolve prompt: --pipe reads stdin, optionally prepended with positional arg
    if args.pipe or (not sys.stdin.isatty() and not args.prompt):
        stdin_text = sys.stdin.read().strip()
        if args.prompt:
            prompt = f"{args.prompt}\n\n{stdin_text}"
        else:
            prompt = stdin_text
    else:
        prompt = args.prompt

    if not prompt:
        parser.print_help()
        sys.exit(1)

    # Resolve group → jid
    jid = args.jid
    group_name = None
    group_folder = None
    is_main = False

    if args.group:
        g = find_group(groups, args.group)
        if g is None:
            sys.exit(f"error: group '{args.group}' not found. Run --list-groups to see options.")
        jid = g["jid"]
        group_name = g["name"]
        group_folder = g["folder"]
        is_main = g["is_main"]
    elif not jid:
        # Default: main group
        mains = [g for g in groups if g["is_main"]]
        if mains:
            jid = mains[0]["jid"]
            group_name = mains[0]["name"]
            group_folder = mains[0]["folder"]
            is_main = True
        else:
            sys.exit("error: no group specified and no main group found. Use -g or -j.")

    runtime = detect_runtime(args.runtime)
    secrets = read_secrets(ENV_FILE)

    if not secrets:
        print("warning: no secrets found in .env — agent may not be authenticated", file=sys.stderr)

    payload: dict = {
        "prompt": prompt,
        "chatJid": jid,
        "isMain": is_main,
        "secrets": secrets,
    }
    if group_name:
        payload["groupFolder"] = group_name
    if args.session:
        payload["sessionId"] = args.session
        payload["resumeAt"] = "latest"

    print(f"[{group_name or jid}] running via {runtime}...", file=sys.stderr)
    run_container(runtime, args.image, payload,
                  folder=group_folder, is_main=is_main,
                  timeout=args.timeout)


if __name__ == "__main__":
    main()
